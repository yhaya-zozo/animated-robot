# Google Sheets
GOOGLE_SHEET_ID=your_google_sheet_id
GOOGLE_SHEET_TAB=Sheet1
GOOGLE_SERVICE_ACCOUNT_JSON=path/to/service-account.json

# WhatsApp API (example with 360dialog/Twilio-like API)
WHATSAPP_API_BASE_URL=https://api.provider.com
WHATSAPP_API_TOKEN=your_api_token
WHATSAPP_SENDER_ID=your_sender_id

# Reminder settings
REMINDER_DAYS_BEFORE=1

# Columns (Arabic headers in the sheet)
COL_NAME=الاسم
COL_PHONE=رقم الواتساب
COL_EVENT_DATE=تاريخ الإيفنت
COL_STATUS=الحالة
COL_SENT=تم الإرسال؟
COL_TEMPLATE=قالب الرسالة
